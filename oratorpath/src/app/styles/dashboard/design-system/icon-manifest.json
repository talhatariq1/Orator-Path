{
  "manifestVersion": "1.0",
  "description": "Icon manifest for Orator Path Dashboard",
  "baseDirectory": "/src/app/styles/dashboard/design-system/icons/",
  "iconSize": {
    "default": 24,
    "small": 16,
    "large": 32,
    "extraLarge": 48
  },
  "colorVariants": {
    "primary": "rgb(var(--color-primary))",
    "secondary": "rgb(var(--color-secondary))",
    "accent": "rgb(var(--color-accent))",
    "textPrimary": "rgb(var(--color-text-primary))",
    "textSecondary": "rgb(var(--color-text-secondary))",
    "textTertiary": "rgb(var(--color-text-tertiary))",
    "success": "rgb(var(--color-success))",
    "warning": "rgb(var(--color-warning))",
    "error": "rgb(var(--color-error))",
    "info": "rgb(var(--color-info))",
    "white": "#FFFFFF"
  },
  "icons": [
    {
      "id": "dashboard",
      "filename": "dashboard.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/dashboard.svg",
      "description": "Dashboard home icon",
      "recommendedColor": "primary",
      "category": "navigation",
      "keywords": ["home", "dashboard", "overview"]
    },
    {
      "id": "analytics",
      "filename": "analytics.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/analytics.svg",
      "description": "Analytics and statistics icon",
      "recommendedColor": "primary",
      "category": "data",
      "keywords": ["chart", "graph", "analytics", "statistics", "data"]
    },
    {
      "id": "analysis",
      "filename": "analysis.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/analysis.svg",
      "description": "Speech analysis icon",
      "recommendedColor": "secondary",
      "category": "feature",
      "keywords": ["analysis", "deep dive", "examine", "investigate"]
    },
    {
      "id": "chatbot",
      "filename": "chatbot.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/chatbot.svg",
      "description": "AI chat assistant icon",
      "recommendedColor": "secondary",
      "category": "feature",
      "keywords": ["chat", "bot", "assistant", "help", "support"]
    },
    {
      "id": "feedback",
      "filename": "feedback.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/feedback.svg",
      "description": "User feedback and comments icon",
      "recommendedColor": "accent",
      "category": "feature",
      "keywords": ["feedback", "comment", "review", "suggestion"]
    },
    {
      "id": "microphone",
      "filename": "microphone.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/microphone.svg",
      "description": "Microphone for recording speech",
      "recommendedColor": "primary",
      "category": "action",
      "keywords": ["mic", "record", "speech", "audio", "talk"]
    },
    {
      "id": "notification",
      "filename": "notification.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/notification.svg",
      "description": "Notification bell icon",
      "recommendedColor": "textSecondary",
      "category": "UI",
      "keywords": ["bell", "alert", "notification", "reminder"]
    },
    {
      "id": "performance",
      "filename": "performance.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/performance.svg",
      "description": "Performance metrics icon",
      "recommendedColor": "info",
      "category": "data",
      "keywords": ["performance", "speed", "metric", "measure"]
    },
    {
      "id": "practices",
      "filename": "practices.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/practices.svg",
      "description": "Speaking practices icon",
      "recommendedColor": "primary",
      "category": "feature",
      "keywords": ["practice", "exercise", "training", "speech"]
    },
    {
      "id": "profile",
      "filename": "profile.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/profile.svg",
      "description": "User profile icon",
      "recommendedColor": "textSecondary",
      "category": "user",
      "keywords": ["profile", "user", "account", "personal"]
    },
    {
      "id": "progress",
      "filename": "progress.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/progress.svg",
      "description": "User progress tracking icon",
      "recommendedColor": "success",
      "category": "data",
      "keywords": ["progress", "achievement", "growth", "improvement"]
    },
    {
      "id": "search",
      "filename": "search.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/search.svg",
      "description": "Search icon",
      "recommendedColor": "textTertiary",
      "category": "action",
      "keywords": ["search", "find", "lookup", "magnify"]
    },
    {
      "id": "settings",
      "filename": "settings.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/settings.svg",
      "description": "Settings and preferences icon",
      "recommendedColor": "textSecondary",
      "category": "UI",
      "keywords": ["settings", "gear", "preferences", "options", "configure"]
    },
    {
      "id": "video",
      "filename": "video.svg",
      "path": "/src/app/styles/dashboard/design-system/icons/video.svg",
      "description": "Video recording and playback icon",
      "recommendedColor": "primary",
      "category": "media",
      "keywords": ["video", "recording", "playback", "camera", "film"]
    }
  ],
  "usage": {
    "react": "import IconName from 'path/to/icon'; // SVG as React component",
    "css": "background-image: url('/path/to/icon.svg');",
    "html": "<img src='/path/to/icon.svg' alt='Icon description' />"
  },
  "guidelines": {
    "navigation": "Use primary color for active state, textTertiary for inactive",
    "feature": "Use primary or secondary colors to highlight key features",
    "action": "Use primary or accent color for interactive actions",
    "data": "Use semantic colors to indicate data types and statuses",
    "sizing": "Maintain 24px as default, use consistent sizes for similar icon types",
    "accessibility": "Ensure icons have text labels or aria-labels for screen readers"
  }
}